# ============================================================================
# SIH 26188 — Backend configuration template
# Copy to .env and fill in. Every key here matches app/core/config.py exactly.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE PROJECT (Dashboard -> Project Settings -> API)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 2. SUPABASE POSTGRES
# ----------------------------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Database password.
# The service-role JWT is NOT a valid Postgres password; this is separate.
SUPABASE_DB_PASSWORD=

# Leave blank for local dev (direct connection, db.<ref>.supabase.co:5432).
# For serverless/Vercel use the transaction pooler:
#   SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_PORT=6543
#   SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=

# Full URI alternative. When set it overrides the derived URL above.
DATABASE_URL=

# true  = refuse to boot unless connected to Supabase Postgres (recommended)
# false = allow SQLite fallback for offline development only
REQUIRE_SUPABASE=true

# ----------------------------------------------------------------------------
# 3. SECURITY & JWT
# ----------------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
BYPASS_AUTH=false

# ----------------------------------------------------------------------------
# 4. ADMIN BOOTSTRAP
# ----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
AUTO_APPROVE_USERS=true
REQUIRE_ADMIN_APPROVAL=false

# ----------------------------------------------------------------------------
# 5. CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ----------------------------------------------------------------------------
# 6. SUPABASE STORAGE
# ----------------------------------------------------------------------------
# Hyphens, not underscores. Must match config.py defaults.
STORAGE_DOCUMENT_BUCKET=document-images
STORAGE_FACE_BUCKET=face-captures
STORAGE_MAX_FILE_SIZE_MB=15
STORAGE_SIGNED_URL_TTL_SECONDS=3600
UPLOAD_DIR=./uploads
KEEP_LOCAL_UPLOAD_COPY=false

# ----------------------------------------------------------------------------
# 7. CHECKPOINT GEOLOCATION
# ----------------------------------------------------------------------------
CHECKPOINT_NAME=IGI Airport Terminal 3
CHECKPOINT_LATITUDE=28.5562
CHECKPOINT_LONGITUDE=77.1000

# ----------------------------------------------------------------------------
# 8. OCR
# ----------------------------------------------------------------------------
# google_vision (HTTP API, required on serverless) | local (Tesseract/Apple Vision)
OCR_PROVIDER=google_vision
OCR_FALLBACK_ENABLED=true
OCR_LOCAL_ENGINES=tesseract,apple_vision,windows
TESSERACT_CMD=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VISION_API_KEY=
VISION_MAX_IMAGE_BYTES=10485760
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_MAX_RETRIES=2

# ----------------------------------------------------------------------------
# 9. BLOCKCHAIN AUDIT ANCHOR (optional)
# ----------------------------------------------------------------------------
BLOCKCHAIN_ANCHOR_ENABLED=false
GOOGLE_BLOCKCHAIN_API_KEY=
GOOGLE_BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_ANCHOR_PRIVATE_KEY=
BLOCKCHAIN_ANCHOR_FROM_ADDRESS=
BLOCKCHAIN_CHAIN_ID=11155111

# ----------------------------------------------------------------------------
# 10. WATCHLIST & SANCTIONS SCREENING
# ----------------------------------------------------------------------------
# Free self-serve key for non-commercial use: https://www.opensanctions.org/docs/api/
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_API_URL=https://api.opensanctions.org
OPENSANCTIONS_ENABLED=false
# "default" covers sanctions + PEPs + crime/INTERPOL lists.
OPENSANCTIONS_DATASET=default
OPENSANCTIONS_TIMEOUT_SECONDS=12
# Candidate scores below this are dropped as noise.
OPENSANCTIONS_MATCH_THRESHOLD=0.70
INTERPOL_ENABLED=false
SYNTHETIC_WATCHLIST_ENABLED=true

# ----------------------------------------------------------------------------
# 11. BIOMETRIC / FORENSIC THRESHOLDS
# ----------------------------------------------------------------------------
# All of these are read by the services at runtime. Editing them changes
# behaviour — they are no longer decorative.
FACE_SIMILARITY_THRESHOLD=0.70
FACE_CROSS_DOMAIN_COSINE_THRESHOLD=0.30
FACE_QUALITY_THRESHOLD=0.5
LIVENESS_THRESHOLD=0.6
FACE_IDENTITY_MATCH_THRESHOLD=0.62
FORENSICS_ELA_QUALITY=95
FORENSICS_TAMPERING_THRESHOLD=0.60
VALIDATION_STRICT_MODE=true
VALIDATION_ICAO_COMPLIANCE=true

# ----------------------------------------------------------------------------
# 12. ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
